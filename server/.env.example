# MongoDB connection. Local MongoDB example:
MONGODB_URI=mongodb://127.0.0.1:27017/spyrix_invoice

# Generate a long random secret (at least 32 characters). Never commit server/.env.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Google sign-in is disabled in the UI for now. Add GOOGLE_CLIENT_ID here if enabled later.
